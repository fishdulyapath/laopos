  { label: 'บาท', value: 'THB', name: 'บาท', rate: 1 },
  { label: 'กีบ', value: 'LAK', name: 'กีบ', rate: 0 },
  { label: 'หยวน', value: 'CNY', name: 'หยวน', rate: 0 },
]

const docFormatOptions = computed(() =>
  docFormats.value.map((format) => ({
    ...format,
    label: `${format.code} - ${format.name_1 || ''}`,
  })),
)

