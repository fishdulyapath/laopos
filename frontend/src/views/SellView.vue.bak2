function parseBarcodeInput(value) {
  let text = String(value || '').trim()
  let qty = 1
  const qtyMatch = text.match(/^(\d+(?:\.\d+)?)\s*\*\s*(.+)$/)
  if (qtyMatch) {
    qty = Number(qtyMatch[1])
    text = qtyMatch[2].trim()
  }
  const shelfIndex = text.indexOf('#')
  if (shelfIndex >= 0) text = text.slice(0, shelfIndex).trim()
  return { barcode: text, qty: Number.isFinite(qty) && qty > 0 ? qty : 1 }
}

function unitRatio(unit) {
  return Math.max(1, Number(unit?.ratio) || Number(unit?.stand_value) / Number(unit?.divide_value || 1) || 1)
}

function isServiceItem(row) {
  return String(row?.item_type ?? '') === '1'
}

// สินค้าชุด (item_type=3) — ห้ามเช็คสต๊อกที่ frontend, ราคาดึงจาก /getProductSetDetail
// children เก็บใน line.sub_item แล้วส่งไป backend (backend จะ persist child rows ให้)
function isSetItem(row) {
  return String(row?.item_type ?? '') === '3'
}

// เลือก unit ที่ตรงกับ start_sale_unit จาก rows ของ getProductSetDetail
// (smlstaff-ubon ใช้ pattern เดียวกัน)
function pickSetUnitRow(rows, product) {
  if (!Array.isArray(rows) || rows.length === 0) return null
  const preferred = product?.unit_code || product?.start_sale_unit || product?.unit_standard || product?.unit_cost || ''
  return rows.find((r) => r.unit_code === preferred) || rows[0]
}

function unitBaseBalance(unit, ratio = unitRatio(unit)) {
  return Number(unit?.sum_balance_qty ?? (Number(unit?.balance_qty ?? 0) * ratio))
}

function preferredUnit(product, units) {
  if (product.unit_code) {
    return units.find((unit) => unit.unit_code === product.unit_code) || product
  }
  const preferred = product.start_sale_unit || product.unit_standard || product.unit_cost || ''
  return units.find((unit) => unit.unit_code === preferred) || units[0] || product
}

async function resolveSelectedUnit(product, barcode = '') {
  const selectedBarcode = barcode || product.barcode || ''

  // สินค้าชุด: ต้องดึงหน่วย/ราคาจาก /getProductSetDetail เสมอ
  // (ห้ามใช้ /getProductDetail หรือ barcode unit เพราะราคาจะคำนวณผิด)
  if (isSetItem(product)) {
    const setRows = await getProductSetDetail(product.item_code, custCode.value, priceOpts())
    const setUnit = pickSetUnitRow(setRows, product)
    if (!setUnit) throw new Error('ไม่พบรายละเอียดสินค้าชุด')
    return {
      ...product,
      ...setUnit,
      barcode: selectedBarcode || setUnit.barcode || product.barcode || '',
      item_type: '3',
    }
  }

  const hasStockDetail = product.item_code && product.unit_code && (
    product.balance_qty !== undefined || product.sum_balance_qty !== undefined
  )
  if (hasStockDetail) {
    return { ...product, barcode: selectedBarcode || product.barcode || '' }
  }

  if (selectedBarcode) {
    const barcodeUnit = await getProductByBarcodeDetail(selectedBarcode).catch(() => null)
    if (barcodeUnit?.item_code) {
      return {
        ...product,
        ...barcodeUnit,
        barcode: selectedBarcode,
        unit_code: barcodeUnit.unit_code || product.unit_code,
      }
    }
  }

  const units = await getProductDetail(product.item_code, custCode.value, priceOpts())
  return preferredUnit(product, units)
}

async function makeLine(product, qty = 1, barcode = '') {
  const unit = await resolveSelectedUnit(product, barcode)
  if (!unit?.item_code) throw new Error('ไม่พบหน่วยขายของสินค้า')
  const effectiveBarcode = barcode || unit.barcode || product.barcode || ''
  const itemType = String(unit.item_type ?? product.item_type ?? '0')
  const isSet = itemType === '3'

  // สินค้าชุด: ราคามาจาก getProductSetDetail แล้ว (อยู่ใน unit.price) — ไม่เรียก getProductPrice
  // และต้องโหลด sub_item (children) เก็บไว้ใน line เพื่อส่งไป backend ตอน save
  let priceResult = null
  let subItems = []
  if (isSet) {
    priceResult = {
      price: unit.price,
      defaultDiscount: unit.defaultDiscount || '',
      type: unit.type ?? unit.price_type ?? 1,
      mode: unit.mode ?? '',
    }
    subItems = await getProductSetItem(unit.item_code).catch(() => [])
  } else {
    priceResult = await getProductPrice(unit.item_code, unit.unit_code, custCode.value, String(qty), {
      ...priceOpts(),
      barcode: effectiveBarcode,
    })
  }

  const ratio = unitRatio(unit)
  const line = {
    id: makeLineId(),
    item_code: unit.item_code,
    item_name: unit.item_name || product.item_name || product.name_1 || '',
    unit_code: unit.unit_code,
    barcode: effectiveBarcode,
    qty,
    price: toNumber(priceResult?.price ?? product.price ?? unit.price ?? 0),
    discount: priceResult?.defaultDiscount || '',
    price_type: toNumber(priceResult?.type ?? unit.type ?? product.type ?? priceResult?.price_type ?? unit.price_type ?? product.price_type ?? 1, 1),
    price_info: priceResult?.mode ?? unit.mode ?? '',
    price_default: toNumber(priceResult?.price ?? product.price_default ?? product.price ?? unit.price ?? 0),
    have_point: unit.have_point === true || unit.have_point === '1' || product.have_point === true || product.have_point === '1',
    drink_type: toNumber(unit.drink_type ?? product.drink_type ?? 0),
    no_discount: unit.no_discount === true || unit.no_discount === '1' || product.no_discount === true || product.no_discount === '1',
    price_loading: false,
    price_error: '',
    discount_amount: 0,
    sum_amount: 0,
    tax_type: toNumber(unit.tax_type ?? product.tax_type ?? 0),
    item_type: itemType,
    wh_code: unit.wh_code || unit.start_sale_wh || posStore.selectedPos?.pos_ic_wht || '',
    shelf_code: unit.shelf_code || unit.start_sale_shelf || posStore.selectedPos?.pos_ic_shelf || '',
    stand_value: toNumber(unit.stand_value, 1),
    divide_value: toNumber(unit.divide_value, 1),
    ratio,
    balance_base: isSet ? 0 : unitBaseBalance(unit, ratio),
    remark: '',
    // children ของสินค้าชุด — backend จะ persist เป็น ic_trans_detail child rows
    sub_item: isSet ? subItems : [],
  }
  if (line.wh_code) void ensureShelfOptions(line.wh_code)
  return line
}

function mergeOrPushLine(line) {
  const existing = rows.value.find((row) =>
    row.item_code === line.item_code &&
    row.unit_code === line.unit_code &&
    String(row.barcode || '') === String(line.barcode || '') &&
    String(row.wh_code || '') === String(line.wh_code || '') &&
    String(row.shelf_code || '') === String(line.shelf_code || '')
  )
  if (existing) {
    existing.qty = rnd(toNumber(existing.qty) + toNumber(line.qty))
    existing.price = line.price
    existing.discount = line.discount
    existing.price_type = line.price_type
    existing.price_info = line.price_info
    existing.price_default = line.price_default
    existing.have_point = line.have_point
    existing.drink_type = line.drink_type
    existing.no_discount = line.no_discount
    // สินค้าชุด: refresh sub_item ด้วย (เผื่อ child price/qty เปลี่ยนตาม customer)
    if (isSetItem(line) && Array.isArray(line.sub_item) && line.sub_item.length) {
      existing.sub_item = line.sub_item
    }
    return
  }
  rows.value.push(line)
}

function inputEventValue(event) {
  return event?.value ?? event?.target?.value ?? event
}

function setLineQty(line, value) {
  if (documentLocked.value) return
  const qty = toNumber(inputEventValue(value))
  if (qty < 0) return
  line.qty = qty
  schedulePriceRefresh()
}

function setLinePrice(line, value) {
  if (documentLocked.value) return
  const price = toNumber(inputEventValue(value))
  if (price < 0) return
  line.price = price
  line.price_error = ''
}

function adjustLineQty(line, delta) {
  if (documentLocked.value) return
  setLineQty(line, rnd(toNumber(line.qty) + delta))
}

function openPriceEditor(line) {
  if (documentLocked.value || line.price_loading) return
  priceEditLine.value = line
  priceEditValue.value = toNumber(line.price)
  priceEditorVisible.value = true
}

function confirmPriceEditor() {
  if (!priceEditLine.value) return
  setLinePrice(priceEditLine.value, priceEditValue.value)
  priceEditorVisible.value = false
  priceEditLine.value = null
}

function openRemarkEditor(line) {
  if (documentLocked.value) return
  remarkEditLine.value = line
  remarkEditText.value = line.remark || ''
  remarkEditorVisible.value = true
}

function confirmRemarkEditor() {
  if (!remarkEditLine.value) return
  remarkEditLine.value.remark = remarkEditText.value.trim()
  remarkEditorVisible.value = false
  remarkEditLine.value = null
}

function schedulePriceRefresh(delay = 350) {
  clearTimeout(priceRefreshTimer)
  if (!rows.value.length) return
  priceRefreshTimer = setTimeout(() => {
    void refreshLinePrices()
  }, delay)
}

async function refreshLinePrices() {
  if (!rows.value.length) return
  const runId = ++priceRefreshRunId
  priceRefreshing.value = true
  try {
    await Promise.all(rows.value.map(async (line) => {
      if (!line.item_code || !line.unit_code || toNumber(line.qty) <= 0) return
      line.price_loading = true
      line.price_error = ''
      try {
        // สินค้าชุด: ใช้ /getProductSetDetail (ราคา parent ตาม customer/sale_type/vat)
        // และ re-fetch sub_item เผื่อ children ถูกแก้ใน master
        if (isSetItem(line)) {
          const setRows = await getProductSetDetail(line.item_code, custCode.value, priceOpts())
          if (runId !== priceRefreshRunId) return
          const setUnit = setRows.find((r) => r.unit_code === line.unit_code) || setRows[0] || null
          if (setUnit) {
            line.price = toNumber(setUnit.price ?? line.price)
            line.price_default = toNumber(setUnit.price ?? line.price_default ?? line.price)
            line.price_type = toNumber(setUnit.type ?? setUnit.price_type ?? line.price_type ?? 1, 1)
            line.price_info = setUnit.mode ?? line.price_info ?? ''
          }
          const subItems = await getProductSetItem(line.item_code).catch(() => null)
          if (runId !== priceRefreshRunId) return
          if (Array.isArray(subItems) && subItems.length) line.sub_item = subItems
          return
        }

        const price = await getProductPrice(line.item_code, line.unit_code, custCode.value, String(line.qty), {
          ...priceOpts(),
          barcode: line.barcode || '',
        })
        if (runId !== priceRefreshRunId) return
        line.price = toNumber(price?.price ?? line.price)
        line.discount = price?.defaultDiscount ?? line.discount ?? ''
        line.price_type = toNumber(price?.type ?? price?.price_type ?? line.price_type ?? 1, 1)
        line.price_info = price?.mode ?? line.price_info ?? ''
        line.price_default = toNumber(price?.price ?? line.price_default ?? line.price)
      } catch (error) {
        if (runId !== priceRefreshRunId) return
        line.price_error = error.message || 'ดึงราคาไม่สำเร็จ'
      } finally {
        if (runId === priceRefreshRunId) line.price_loading = false
      }
    }))
  } finally {
    if (runId === priceRefreshRunId) priceRefreshing.value = false
  }
}

function clearPromotionCalculation() {
  clearTimeout(promotionTimer)
  promotionRunId += 1
  promotionLoading.value = false
  promotionDirty.value = false
  promotionError.value = ''
  promotionResults.value = []
  promotionProductRows.value = []
  promotionDiscountRaw.value = 0
  promotionLastCalculatedAt.value = ''
}

function promotionDiscountNumber(line) {
  return String(line.discount || line.discount_amount || '').trim() ? 1 : 0
}

function buildPromotionItems() {
  return validRows.value.map((line) => ({
    item_code: line.item_code,
    item_name: line.item_name,
    unit_code: line.unit_code,
    barcode: line.barcode || '',
    qty: toNumber(line.qty),
    price: toNumber(line.price),
    amount: lineSumAmount(line),
    discount_word: line.discount || '',
    discount: lineDiscountAmount(line),
    tax_type: toNumber(line.tax_type),
    vat_type: vatType.value,
    vat_rate: toNumber(vatRate.value, 7),
    stand_value: toNumber(line.stand_value, 1),
    divide_value: toNumber(line.divide_value, 1),
    price_type: toNumber(line.price_type ?? 1, 1),
    price_default: toNumber(line.price_default ?? line.price),
    price_info: line.price_info || '',
    discount_number: promotionDiscountNumber(line),
    drink_type: toNumber(line.drink_type),
    have_point: line.have_point === true,
    no_discount: line.no_discount === true,
  }))
}

function buildPromotionPayload() {
  return {
    pos_id: posStore.posId,
    cust_code: custCode.value || 'AR00001',
    member_code: custCode.value || 'AR00001',
    pos_default_cust: 'AR00001',
    doc_date: docDate.value,
    items: buildPromotionItems(),
  }
}

function buildPromotionGuidePayload(items = buildPromotionGuideItems()) {
  return {
    pos_id: posStore.posId,
    cust_code: custCode.value || defaultCustomerCode,
    member_code: custCode.value || defaultCustomerCode,
    pos_default_cust: defaultCustomerCode,
    doc_date: docDate.value,
    items,
  }
}

function clearPromotionGuide() {
  clearTimeout(promotionGuideTimer)
  promotionGuideRunId += 1
  promotionGuideLoading.value = false
  promotionGuideError.value = ''
  promotionGuideMap.value = {}
  promotionGuideDialogVisible.value = false
  promotionGuideDialogLine.value = null
}

function schedulePromotionGuideCheck(delay = 300) {
  clearTimeout(promotionGuideTimer)
  const items = buildPromotionGuideItems()
  if (!items.length) {
    clearPromotionGuide()
    return
  }
  const runId = ++promotionGuideRunId
  promotionGuideError.value = ''
  promotionGuideTimer = setTimeout(() => {
    void runPromotionGuideCheck(runId, items)
  }, delay)
}

async function runPromotionGuideCheck(runId = ++promotionGuideRunId, items = buildPromotionGuideItems()) {
  if (runId !== promotionGuideRunId || !items.length) return
  promotionGuideLoading.value = true
  promotionGuideError.value = ''
  try {
    const result = await getPromotionItemHints(buildPromotionGuidePayload(items))
    if (runId !== promotionGuideRunId) return
    if (!result?.success) throw new Error(result?.message || result?.msg || 'โหลดโปรโมชั่นที่เกี่ยวข้องไม่สำเร็จ')
    const map = {}
    for (const row of Array.isArray(result.data) ? result.data : []) {
      map[promotionGuideKey(row.item_code, row.unit_code)] = row
    }
    promotionGuideMap.value = map
  } catch (error) {
    if (runId !== promotionGuideRunId) return
    promotionGuideMap.value = {}
    promotionGuideError.value = error.message || 'โหลดโปรโมชั่นที่เกี่ยวข้องไม่สำเร็จ'
  } finally {
    if (runId === promotionGuideRunId) promotionGuideLoading.value = false
  }
}

function openPromotionGuideDialog(line) {
  promotionGuideDialogLine.value = line
  promotionGuideDialogVisible.value = true
}

function promotionCalculatedTime() {
  return new Date().toLocaleTimeString('th-TH', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  })
}

function schedulePromotionCalculation(delay = 450) {
  clearTimeout(promotionTimer)
  if (!validRows.value.length) {
    clearPromotionCalculation()
    return
  }
  const runId = ++promotionRunId
  promotionDirty.value = true
  promotionError.value = ''
  promotionTimer = setTimeout(() => {
    void runPromotionCalculation(runId)
  }, delay)
}

function recalculatePromotionNow() {
  clearTimeout(promotionTimer)
  if (!validRows.value.length) {
    clearPromotionCalculation()
    return
  }
  const runId = ++promotionRunId
  promotionDirty.value = true
  promotionError.value = ''
  void runPromotionCalculation(runId)
}

async function runPromotionCalculation(runId = ++promotionRunId) {
  if (runId !== promotionRunId) return
  if (!validRows.value.length) {
    clearPromotionCalculation()
    return
  }
  if (priceRefreshing.value) {
    schedulePromotionCalculation(250)
    return
  }

  promotionLoading.value = true
  promotionError.value = ''
  try {
    const result = await processPromotion(buildPromotionPayload())
    if (runId !== promotionRunId) return
    if (!result?.success) throw new Error(result?.msg || result?.message || 'คำนวณโปรโมชั่นไม่สำเร็จ')
    promotionResults.value = Array.isArray(result.data) ? result.data : []
    promotionProductRows.value = Array.isArray(result.promotion_product_rows) ? result.promotion_product_rows : []
    promotionDiscountRaw.value = toNumber(result.promotion_discount_amount)
    promotionLastCalculatedAt.value = promotionCalculatedTime()
    promotionDirty.value = false
  } catch (error) {
    if (runId !== promotionRunId) return
    promotionResults.value = []
    promotionProductRows.value = []
    promotionDiscountRaw.value = 0
    promotionLastCalculatedAt.value = ''
    promotionDirty.value = false
    promotionError.value = error.message || 'คำนวณโปรโมชั่นไม่สำเร็จ'
  } finally {
    if (runId === promotionRunId) promotionLoading.value = false
  }
}

async function addProduct(product, qty = 1, barcode = '') {
  const line = await makeLine(product, qty, barcode)
  mergeOrPushLine(line)
  toast.add({ severity: 'success', summary: 'เพิ่มสินค้าแล้ว', detail: `${line.item_name} x ${qty}`, life: 1400 })
}

async function searchProducts() {
  if (documentLocked.value) return
  const query = productSearch.value.trim()
  if (!query) return
  productLoading.value = true
  errorMsg.value = ''
  try {
    productResults.value = await getProductBarcodeSearch({
      search: query,
      offset: 0,
      limit: 50,
      include_balance: '1',
      wh_code: posStore.selectedPos?.pos_ic_wht || '',
      shelf_code: posStore.selectedPos?.pos_ic_shelf || '',
    })
    productDialogVisible.value = true
    if (!productResults.value.length) errorMsg.value = 'ไม่พบสินค้า'
  } catch (error) {
    errorMsg.value = error.message || 'ค้นหาสินค้าไม่สำเร็จ'
  } finally {
    productLoading.value = false
  }
}

async function addProductFromSearch(product) {
  if (documentLocked.value) return
  try {
    await addProduct(product, 1, product.barcode || '')
    productDialogVisible.value = false
    productSearch.value = ''
  } catch (error) {
    errorMsg.value = error.message || 'เพิ่มสินค้าไม่สำเร็จ'
  }
}

async function addProductBasketToSale(items = []) {
  if (documentLocked.value || !items.length) return
  productLoading.value = true
  errorMsg.value = ''
  try {
    let addedCount = 0
    for (const item of items) {
      const product = item?.product || item
      const qty = toNumber(item?.qty, 1)
      if (!product || qty <= 0) continue
      await addProduct(product, qty, product.barcode || '')
      addedCount += 1
    }
    if (addedCount) {
      toast.add({ severity: 'success', summary: 'เพิ่มสินค้าจากตะกร้าแล้ว', detail: `${addedCount} รายการ`, life: 1800 })
    }
  } catch (error) {
    errorMsg.value = error.message || 'เพิ่มสินค้าจากตะกร้าไม่สำเร็จ'
  } finally {
    productLoading.value = false
  }
}

async function addBarcode() {
  if (documentLocked.value || barcodeAdding.value) return
  const { barcode, qty } = parseBarcodeInput(barcodeInput.value)
  if (!barcode) return
  barcodeAdding.value = true
  errorMsg.value = ''
  try {
    const product = await getProductByBarcodeDetail(barcode)
    if (!product) throw new Error(`ไม่พบสินค้าจากบาร์โค้ด ${barcode}`)
    await addProduct(product, qty, barcode)
    barcodeInput.value = ''
  } catch (error) {
    errorMsg.value = error.message || 'เพิ่มสินค้าจากบาร์โค้ดไม่สำเร็จ'
  } finally {
    barcodeAdding.value = false
    await nextTick()
    barcodeRef.value?.$el?.querySelector?.('input')?.focus?.()
  }
}

function removeLine(index) {
  if (documentLocked.value) return
  rows.value.splice(index, 1)
}

function refreshPaymentReviewAfterEdit() {
  paymentReviewNeeded.value = false
  paymentReviewTotal.value = paymentEntries.value.length ? totalDue.value : null
  setCashAmountFromBaht(remainingPayment.value)
  transferInputAmount.value = remainingPayment.value
  creditInputAmount.value = remainingPayment.value
}

function confirmPaymentReview() {
  refreshPaymentReviewAfterEdit()
}

async function refreshCouponOptions() {
  couponOptions.value = await getCouponList({
    search: couponSearch.value,
    cust_code: custCode.value || defaultCustomerCode,
    doc_date: docDate.value,
    total_amount: totals.value.totalAmount,
  }).catch(() => [])
  couponOptions.value = couponOptions.value.map((row) => ({
    ...row,
    label: `${row.number || ''} ${row.remark || ''} ${formatCurrency(row.available_amount ?? row.balance_amount)}`.trim(),
  }))
}

async function refreshDepositOptions() {
  depositOptions.value = await getSaleDepositBalanceList({
    search: depositSearch.value,
    cust_code: custCode.value || defaultCustomerCode,
    doc_date: docDate.value,
  }).catch(() => [])
  depositOptions.value = depositOptions.value.map((row) => ({
    ...row,
    label: `${row.doc_no || ''} ${formatCurrency(row.balance_amount)}${row.currency_code ? ` ${row.currency_code}` : ''}`.trim(),
  }))
}

function addCash() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = cashConvertedAmount.value
  const currency = selectedCashCurrency.value
  if (amount <= 0 || toNumber(cashExchangeRate.value) <= 0) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'cash',
    label: currency.value === 'THB' ? 'เงินสด' : `เงินสด ${currency.name}`,
    amount,
    details: {
      currency_code: currency.value,
      currency_name: currency.name,
      currency_amount: toNumber(cashCurrencyAmount.value),
      exchange_rate: toNumber(cashExchangeRate.value),
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addTransfer() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(transferInputAmount.value)
  if (amount <= 0 || !transferPassBook.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'transfer',
    label: transferPassBook.value.label || transferPassBook.value.book_code || 'โอน',
    amount,
    details: {
      doc_type: 1,
      trans_number: transferPassBook.value.book_code || transferPassBook.value.pass_book_code || transferPassBook.value.code || '',
      pass_book_code: transferPassBook.value.book_code || transferPassBook.value.pass_book_code || transferPassBook.value.code || '',
      bank_code: transferPassBook.value.bank_code || '',
      bank_branch: transferPassBook.value.bank_branch || '',
      transfer_date: transferDate.value,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addCredit() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(creditInputAmount.value)
  if (amount <= 0 || !creditCardNumber.value) return
  const chargeRate = creditType.value?.charge_rate_word ?? creditType.value?.charge_rate
  const charge = toNumber(paymentMasterOptions.value.input_credit_card_charge) === 1
    ? 0
    : calcPaymentCharge(amount, chargeRate)
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'credit',
    label: creditType.value?.label || 'บัตรเครดิต',
    amount,
    details: {
      doc_type: 3,
      trans_number: creditCardNumber.value,
      credit_card_type: creditType.value?.code || creditType.value?.credit_card_type || '',
      card_number: creditCardNumber.value,
      no_approved: creditApprovalNo.value,
      charge,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addCheque() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(chequeAmount.value)
  if (amount <= 0 || !chequeNumber.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'cheque',
    label: 'เช็ค',
    amount,
    details: {
      doc_type: 2,
      trans_number: chequeNumber.value,
      pass_book_code: chequePassBook.value?.code || '',
      bank_code: chequePassBook.value?.bank_code || '',
      bank_branch: chequePassBook.value?.bank_branch || '',
      chq_due_date: chequeDueDate.value,
      sum_amount: amount,
      currency_code: chequePassBook.value?.currency_code || '',
      exchange_rate: 1,
      sum_amount_2: amount,
      chq_on_hand: 0,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addPettyCash() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(pettyCashAmount.value)
  if (amount <= 0 || !pettyCashAccount.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'petty',
    label: pettyCashAccount.value.label || 'เงินสดย่อย',
    amount,
    details: {
      doc_type: 4,
      trans_number: pettyCashAccount.value.code || '',
      description: pettyCashAccount.value.name_1 || '',
      currency_code: pettyCashAccount.value.currency_code || '',
      exchange_rate: 1,
      sum_amount_2: amount,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addDeposit() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(depositAmount.value)
  const balanceAmount = toNumber(depositDoc.value?.balance_amount)
  if (amount <= 0 || !depositDoc.value || amount > balanceAmount) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'deposit',
    label: depositDoc.value.doc_no || 'เงินล่วงหน้า',
    amount,
    details: {
      doc_type: 5,
      trans_number: depositDoc.value.doc_no || '',
      doc_date_ref: depositDoc.value.doc_date || '',
      sum_amount: toNumber(depositDoc.value.amount),
      balance_amount: balanceAmount,
      currency_code: depositDoc.value.currency_code || '',
      exchange_rate: toNumber(depositDoc.value.exchange_rate, 1),
      sum_amount_2: toNumber(depositDoc.value.currency_amount),
      amount_2: toNumber(depositDoc.value.exchange_rate, 1) > 0 ? rnd(amount / toNumber(depositDoc.value.exchange_rate, 1)) : 0,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addCoupon() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(couponAmount.value)
  const availableAmount = toNumber(
    couponSelected.value?.available_amount ?? couponSelected.value?.usable_amount ?? couponSelected.value?.balance_amount,
  )
  if (amount <= 0 || !couponSelected.value || amount > availableAmount) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'coupon',
    label: couponSelected.value.number || 'คูปอง',
    amount,
    details: {
      doc_type: 9,
      trans_number: couponSelected.value.number || '',
      balance_amount: availableAmount,
      coupon_type: couponSelected.value.coupon_type || '0',
      master_amount: toNumber(couponSelected.value.amount),
      single_use: couponSelected.value.single_use || '0',
      date_expire: couponSelected.value.date_expire || '',
      remark: couponSelected.value.remark || '',
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addIncome() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(incomeAmount.value)
  if (amount <= 0 || !incomeType.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'income',
    label: incomeType.value.label || 'รายได้อื่น',
    amount,
    details: {
      doc_type: 12,
      trans_number: incomeType.value.code || '',
      description: incomeType.value.name_1 || '',
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addExpense() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(expenseAmount.value)
  if (amount <= 0 || !expenseType.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'expense',
    label: expenseType.value.label || 'ค่าใช้จ่ายอื่น',
    amount,
    details: {
      doc_type: 11,
      trans_number: expenseType.value.code || '',
      description: expenseType.value.name_1 || '',
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addOtherCurrency() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(otherCurrencyConvertedAmount.value)
  if (amount <= 0 || !otherCurrency.value || otherCurrencyRate.value <= 0) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'currency',
    label: otherCurrency.value.label || 'สกุลเงินอื่นๆ',
    amount,
    details: {
      doc_type: 19,
      trans_number: otherCurrency.value.code || '',
      currency_code: otherCurrency.value.code || '',
      description: otherCurrency.value.name_1 || '',
      amount: toNumber(otherCurrencyAmount.value),
      exchange_rate: otherCurrencyRate.value,
      sum_amount: amount,
      charge: toNumber(otherCurrencyCharge.value),
    },
  })
  refreshPaymentReviewAfterEdit()
}

function addWallet() {
  if (documentLocked.value || isCreditSale.value) return
  const amount = toNumber(walletAmount.value)
  if (amount <= 0 || !walletNumber.value) return
  paymentEntries.value.push({
    id: makeLineId(),
    type: 'wallet',
    label: walletType.value?.label || 'Wallet',
    amount,
    details: {
      doc_type: 21,
      trans_number: walletNumber.value,
      credit_card_type: walletType.value?.code || '',
      description: walletType.value?.name_1 || '',
      no_approved: walletApprovedNo.value,
      ref1: walletRef1.value,
      ref2: walletRef2.value,
    },
  })
  refreshPaymentReviewAfterEdit()
}

function removePayment(id) {
  if (documentLocked.value) return
  paymentEntries.value = paymentEntries.value.filter((entry) => entry.id !== id)
  refreshPaymentReviewAfterEdit()
}

function buildStockValidationRows() {
  return validRows.value.map((line) => ({
    item_code: line.item_code,
    item_name: line.item_name,
    unit_code: line.unit_code,
    qty: toNumber(line.qty),
    stand_value: toNumber(line.stand_value, 1),
    divide_value: toNumber(line.divide_value, 1),
    ratio: unitRatio(line),
    item_type: line.item_type,
    wh_code: line.wh_code || posStore.selectedPos?.pos_ic_wht || '',
    shelf_code: line.shelf_code || posStore.selectedPos?.pos_ic_shelf || '',
  }))
}

async function validateStockBeforeSave(stockRows = buildStockValidationRows()) {
  const groups = new Map()
  for (const line of stockRows) {
    // service (item_type=1) และ สินค้าชุด (item_type=3) ไม่เช็คสต๊อกที่ frontend
    // — backend คำนวณ component stock ของ set ให้แล้วใน /getProductList
    if (isServiceItem(line) || isSetItem(line)) continue
    const key = `${line.item_code}|${line.wh_code || ''}|${line.shelf_code || ''}`
    const group = groups.get(key) || { line, requestedBase: 0 }
    group.requestedBase += toNumber(line.qty) * unitRatio(line)
    groups.set(key, group)
  }
  for (const { line, requestedBase } of groups.values()) {
    const ratio = unitRatio(line)
    const availableBase = await getInventoryBalance(line.item_code, line.wh_code || '', line.shelf_code || '')
    if (requestedBase > availableBase) {
      const availableQty = Math.max(0, Math.floor(availableBase / ratio))
      throw new Error(`${line.item_name} คงเหลือ ${availableQty} ${line.unit_code}`)
    }
  }
}

function buildSaveSnapshot() {
  return {
    stockRows: buildStockValidationRows(),
    body: buildSaveBody(),
  }
}

function buildSaveBody() {
  const pos = posStore.selectedPos || {}
  const activePayments = isCreditSale.value ? [] : paymentEntries.value
  const rate = toNumber(documentExchangeRate.value, 1)
  const currencyDivider = rate > 0 ? rate : 1
  const cashEntries = activePayments.filter((entry) => entry.type === 'cash')
  const transfers = activePayments.filter((entry) => entry.type === 'transfer')
  const credits = activePayments.filter((entry) => entry.type === 'credit')
  const paymentDetail = activePayments
    .filter((entry) => entry.type !== 'cash')
    .map((entry) => ({
      type: entry.type,
      doc_type: entry.details?.doc_type,
      pay_amount: entry.amount,
      amount: entry.details?.amount ?? entry.amount,
      sum_amount: entry.details?.sum_amount ?? (entry.type === 'credit' ? entry.amount + toNumber(entry.details?.charge) : entry.amount),
      charge: entry.details?.charge || 0,
      trans_number: entry.details?.trans_number || entry.details?.pass_book_code || entry.details?.card_number || '',
      pass_book_code: entry.details?.pass_book_code || '',
      bank_code: entry.details?.bank_code || '',
      bank_branch: entry.details?.bank_branch || '',
      credit_card_type: entry.details?.credit_card_type || '',
      no_approved: entry.details?.no_approved || '',
      ref1: entry.details?.ref1 || '',
      ref2: entry.details?.ref2 || '',
      doc_date_ref: entry.details?.doc_date_ref || '',
      chq_due_date: entry.details?.chq_due_date || entry.details?.transfer_date || '',
      balance_amount: entry.details?.balance_amount || 0,
      description: entry.details?.description || '',
      remark: entry.details?.remark || '',
      currency_code: entry.details?.currency_code || '',
      exchange_rate: entry.details?.exchange_rate || 1,
      sum_amount_2: entry.details?.sum_amount_2 || 0,
      amount_2: entry.details?.amount_2 || 0,
      charge_2: entry.details?.charge_2 || 0,
      exchange_rate_old: entry.details?.exchange_rate_old || 0,
      lost_profit_exchange_amount: entry.details?.lost_profit_exchange_amount || 0,
      chq_on_hand: entry.details?.chq_on_hand || 0,
    }))
  const paymentTypeAmount = (type) => activePayments
    .filter((entry) => entry.type === type)
    .reduce((sum, entry) => sum + toNumber(entry.amount), 0)
  return {
    pos_id: posStore.posId,
    doc_date: docDate.value,
    doc_time: localTimeHHMM(),
    tax_doc_no: taxDocNo.value,
    tax_doc_date: taxDocDate.value,
    creator_code: 'bizsuit',
    doc_format_code: docFormatCode.value,
    form_code: selectedDocFormat.value?.form_code || '',
    branch_code: pos.branch_code || '',
    cust_code: custCode.value || 'AR00001',
    emp_code: saleCode.value,
    shelf_code: pos.pos_ic_shelf || '',
    remark: remark.value,
    remark_2: remark2.value,
    remark_3: remark3.value,
    remark_4: remark4.value,
    remark_5: remark5.value,
    send_type: sendType.value,
    send_day: 0,
    send_date: sendDate.value,
    delivery_date: deliveryDate.value,
    credit_day: toNumber(creditDay.value),
    due_date: dueDate.value,
    credit_date: dueDate.value,
    transport_code: transportType.value?.code || '',
    currency_code: documentCurrency.value?.code || '',
    exchange_rate: rate,
    inquiry_type: inquiryType.value,
    vat_type: vatType.value,
    vat_rate: toNumber(vatRate.value, 7),
    discount_type: posStore.erpOption?.discout_type ?? 0,
    discount_word: discountWord.value,
    promotion_discount_amount: promotionDiscountRaw.value,
    promotion_extra_discount_amount: promotionDiscountAmount.value,
    total_value: totals.value.totalValue,
    total_discount: totals.value.totalDiscount,
    total_before_vat: totals.value.beforeVat,
    total_vat_value: totals.value.vatValue,
    total_after_vat: totals.value.afterVat,
    total_except_vat: totals.value.totalExceptVat,
    total_amount: totals.value.totalAmount,
    total_value_2: rnd(totals.value.totalValue / currencyDivider),
    total_discount_2: rnd(totals.value.totalDiscount / currencyDivider),
    total_amount_2: documentCurrencyAmount.value,
    discount_word_2: discountWord.value,
    total_net_amount: rnd(totals.value.totalAmount + totalExpenseOtherEntries.value + totalCreditChargeEntries.value),
    cash_amount: cashEntries.reduce((sum, entry) => sum + toNumber(entry.amount), 0),
    rounded_amount: toNumber(roundedAmount.value),
    total_income_amount: toNumber(roundedAmount.value),
    tranfer_amount: transfers.reduce((sum, entry) => sum + toNumber(entry.amount), 0),
    chq_amount: paymentTypeAmount('cheque'),
    card_amount: credits.reduce((sum, entry) => sum + toNumber(entry.amount), 0),
    total_credit_charge: credits.reduce((sum, entry) => sum + toNumber(entry.details?.charge), 0),
    petty_cash_amount: paymentTypeAmount('petty'),
    deposit_amount: paymentTypeAmount('deposit'),
    coupon_amount: paymentTypeAmount('coupon'),
    total_income_other: paymentTypeAmount('income'),
    total_expense_other: paymentTypeAmount('expense'),
    total_other_currency: paymentTypeAmount('currency'),
    total_other_currency_charge: activePayments
      .filter((entry) => entry.type === 'currency')
      .reduce((sum, entry) => sum + toNumber(entry.details?.charge), 0),
    tiger_pending: false,
    tiger_order_id: '',
    tiger_ref1: '',
    tiger_ref2: '',
    tiger_amount: 0,
    wallet_amount: paymentTypeAmount('wallet'),
    vat_sale: {
      vat_number: taxDocNo.value,
      tax_doc_no: taxDocNo.value,
      tax_doc_date: taxDocDate.value,
      description: vatSaleDescription.value,
      tax_no: vatSaleTaxNo.value,
      branch_code: vatSaleBranchCode.value,
    },
    shipment: {
      ...shipment.value,
      transport_code: shipment.value.transport_code || transportType.value?.code || '',
    },
    withholding_detail: whtRows.value.map((row, index) => ({
      line_number: index,
      income_type: row.income_type,
      amount: toNumber(row.amount),
      tax_rate: toNumber(row.tax_rate),
      tax_value: toNumber(row.tax_value),
      sum_amount: toNumber(row.amount),
    })),
    gl_detail: manualGlRows.value.map((row, index) => ({
      line_number: index,
      account_code: row.account_code,
      account_name: row.account_name,
      debit: toNumber(row.debit),
      credit: toNumber(row.credit),
    })),
    promotion_detail: promotionProductRows.value,
    payment_detail: paymentDetail,
    items: validRows.value.map((line) => ({
      item_code: line.item_code,
      item_name: line.item_name,
      unit_code: line.unit_code,
      qty: toNumber(line.qty),
      price: toNumber(line.price),
      sum_amount: lineSumAmount(line),
      discount: line.discount || '',
      discount_amount: lineDiscountAmount(line),
      tax_type: toNumber(line.tax_type),
      vat_type: vatType.value,
      vat_rate: toNumber(vatRate.value, 7),
      wh_code: line.wh_code || pos.pos_ic_wht || '',
      shelf_code: line.shelf_code || pos.pos_ic_shelf || '',
      stand_value: toNumber(line.stand_value, 1),
      divide_value: toNumber(line.divide_value, 1),
      ratio: unitRatio(line),
      item_type: line.item_type,
      barcode: line.barcode || '',
      price_type: toNumber(line.price_type ?? 1, 1),
      price_default: toNumber(line.price_default ?? line.price),
      price_info: line.price_info || '',
      discount_number: promotionDiscountNumber(line),
      drink_type: toNumber(line.drink_type),
      have_point: line.have_point === true,
      no_discount: line.no_discount === true,
      remark: line.remark || '',
      // สินค้าชุด: ส่ง children เพื่อให้ backend แตกเป็น ic_trans_detail child rows
      // (set_ref_line, item_code_main, set_ref_price, set_ref_qty, price_set_ratio
      //  คำนวณที่ backend ตามกฎใน MarketPlaceWebServiceExpress)
      sub_item: isSetItem(line) ? (line.sub_item || []) : [],
    })),
  }
}

function buildCreditValidationDetails(result) {
  const details = Array.isArray(result?.details) ? result.details.filter(Boolean) : []
  if (result?.request_ref_no) details.unshift(`เลขที่คำขออนุมัติ ${result.request_ref_no}`)
  return details
}

function openCreditApproveDialog(snapshot, confirmations, result) {
  creditApproveSnapshot.value = snapshot
  creditApproveConfirmations.value = [...confirmations]
  creditApproveUser.value = ''
  creditApprovePassword.value = ''
  creditApproveMessage.value = result?.message || result?.msg || 'ต้องอนุมัติวงเงินเครดิตก่อนบันทึก'
  creditApproveDetails.value = buildCreditValidationDetails(result)
  creditApproveDialogVisible.value = true
}

async function submitCreditApprove() {
  const snapshot = creditApproveSnapshot.value
  if (!snapshot) return
  if (!creditApproveUser.value || !creditApprovePassword.value) {
    creditApproveMessage.value = 'กรุณาระบุผู้อนุมัติและรหัสผ่าน'
    return
  }
  saving.value = true
  try {
    const approve = {
      user_code: creditApproveUser.value,
      password: creditApprovePassword.value,
    }
    creditApproveDialogVisible.value = false
    await persistSaveSnapshot(snapshot, creditApproveConfirmations.value, approve)
  } catch (error) {
    openSaveDialog({
      type: 'error',
      title: 'บันทึกไม่สำเร็จ',
      message: error.message || 'บันทึกไม่สำเร็จ',
    })
  } finally {
    creditApprovePassword.value = ''
    saving.value = false
  }
}

async function persistSaveSnapshot(snapshot, confirmations = [], creditApprove = null) {
  const result = await saveTransAndPro({
    ...snapshot.body,
    credit_confirmations: confirmations,
    ...(creditApprove ? { credit_approve: creditApprove } : {}),
  })
  if (result?.success) {
    successDocNo.value = result.doc_no
    openSaveDialog({
      type: 'success',
      title: 'บันทึกเอกสารสำเร็จ',
      message: `เลขที่เอกสาร ${result.doc_no}`,
    })
    return true
  }

  if (result?.require_approve_password) {
    openCreditApproveDialog(snapshot, confirmations, result)
    return false
  }

  if (result?.require_confirm) {
    openSaveDialog({
      type: 'warn',
      title: result.title || 'ต้องยืนยันก่อนบันทึก',
      message: result.message || result.msg || 'ตรวจพบเงื่อนไขที่ต้องยืนยัน ต้องการดำเนินการต่อหรือไม่',
      details: buildCreditValidationDetails(result),
      primaryLabel: 'ดำเนินการต่อ',
      primarySeverity: 'warning',
      primaryAction: async () => {
        saving.value = true
        try {
          await persistSaveSnapshot(snapshot, [...confirmations, result.require_confirm])
        } catch (error) {
          openSaveDialog({
            type: 'error',
            title: 'บันทึกไม่สำเร็จ',
            message: error.message || 'บันทึกไม่สำเร็จ',
          })
        } finally {
          saving.value = false
        }
      },
    })
    return false
  }

  openSaveDialog({
    type: result?.level === 'info' ? 'info' : 'error',
    title: result?.title || 'บันทึกไม่สำเร็จ',
    message: result?.message || result?.msg || 'บันทึกไม่สำเร็จ',
    details: buildCreditValidationDetails(result),
  })
  return false
}

async function saveDocument() {
  if (saving.value) return
  errorMsg.value = ''
  if (validationMessages.value.length) {
    openSaveDialog({
      type: 'warn',
      title: 'ยังบันทึกไม่ได้',
      message: 'กรุณาตรวจสอบข้อมูลเอกสารก่อนบันทึก',
      details: validationMessages.value,
    })
    return
  }
  saving.value = true
  try {
    const snapshot = buildSaveSnapshot()
    await validateStockBeforeSave(snapshot.stockRows)
    await persistSaveSnapshot(snapshot)
  } catch (error) {
    openSaveDialog({
      type: 'error',
      title: 'บันทึกไม่สำเร็จ',
      message: error.message || 'บันทึกไม่สำเร็จ',
    })
  } finally {
    saving.value = false
  }
}

function newDocument() {
  rows.value = []
  paymentEntries.value = []
  paymentReviewNeeded.value = false
  paymentReviewTotal.value = null
  errorMsg.value = ''
  discountWord.value = ''
  remark.value = ''
  remark2.value = ''
  remark3.value = ''
  remark4.value = ''
  remark5.value = ''
  docDate.value = todayISO()
  creditDay.value = toNumber(customerCredit.value?.credit_day)
  dueDate.value = addDaysISO(docDate.value, creditDay.value)
  sendDate.value = docDate.value
  deliveryDate.value = docDate.value
  sendType.value = 0
  transportType.value = null
  taxDocNo.value = ''
  taxDocDate.value = docDate.value
  vatSaleDescription.value = ''
  vatSaleTaxNo.value = ''
  vatSaleBranchCode.value = ''
  resetShipment()
  whtRows.value = []
  manualGlRows.value = []
  roundedAmount.value = 0
  successDocNo.value = ''
  saveDialogVisible.value = false
  saveDialogPrimaryAction.value = null
  clearPromotionCalculation()
  clearPromotionGuide()
  setCashAmountFromBaht(totals.value.totalAmount)
}

async function openPrintDialog() {
  if (!successDocNo.value) return
  printDialogVisible.value = true
  printLoading.value = true
  printError.value = ''
  printForms.value = []
  selectedPrintForms.value = []
  try {
    const result = await getSalePrintForms(successDocNo.value)
    const forms = result?.forms || []
    printForms.value = forms
    selectedPrintForms.value = forms.filter((form) => form.available && form.is_default).map((form) => form.formcode)
    if (!selectedPrintForms.value.length) {
      selectedPrintForms.value = forms.filter((form) => form.available).slice(0, 1).map((form) => form.formcode)
    }
    if (!forms.length) printError.value = 'เอกสารนี้ยังไม่ได้กำหนด form_code สำหรับพิมพ์'
    else if (!selectedPrintForms.value.length) printError.value = 'ไม่พบฟอร์มที่พร้อมใช้งาน'
  } catch (error) {
    printError.value = error.message || 'โหลดฟอร์มพิมพ์ไม่สำเร็จ'
  } finally {
    printLoading.value = false
  }
}

function confirmPrintForms() {
  if (!successDocNo.value || !selectedPrintForms.value.length) return
  window.open(getSalePrintUrl(successDocNo.value, selectedPrintForms.value, authStore.employee?.user_code || ''), '_blank', 'noopener')
  printDialogVisible.value = false
}
</script>

<template>
  <div class="sell-view biz-page">
    <div class="biz-page-header">
      <div class="biz-page-title-wrap">
        <i class="pi pi-shopping-cart biz-page-icon" />
        <div>
          <h1 class="biz-page-title">ขายสินค้า</h1>
        </div>
      </div>
      <div class="header-actions">
        <Button label="เอกสารใหม่" icon="pi pi-plus" severity="secondary" outlined :disabled="saving" @click="newDocument" />
        <Button
          :label="successDocNo ? `บันทึกแล้ว ${successDocNo}` : `บันทึก ${formatCurrency(totals.totalAmount)}`"
          icon="pi pi-save"
          :loading="saving"
          :disabled="!canSave || !!successDocNo"
          @click="saveDocument"
        />
      </div>
    </div>

    <Message v-if="errorMsg" severity="warn" :closable="false">{{ errorMsg }}</Message>

    <div class="sell-grid">
      <main class="document-workspace">
        <section class="biz-panel document-panel">
          <div class="panel-title">
            <i class="pi pi-file-edit" />
            <strong>หัวเอกสาร</strong>
          </div>
          <div class="doc-grid">
            <label class="field">
              <span>รหัสเอกสาร</span>
              <Select v-model="docFormatCode" :options="docFormatOptions" option-label="label" option-value="code" placeholder="เลือกเอกสาร" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>ประเภทขาย</span>
              <Select v-model="inquiryType" :options="inquiryTypeOptions" option-label="label" option-value="value" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>ประเภทภาษี</span>
              <Select v-model="vatType" :options="vatTypeOptions" option-label="label" option-value="value" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>VAT %</span>
              <InputNumber v-model="vatRate" input-class="text-right" :min="0" :min-fraction-digits="0" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>วันที่เอกสาร</span>
              <InputText v-model="docDate" type="date" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>เครดิต (วัน)</span>
              <InputNumber v-model="creditDay" input-class="text-right" :min="0" :max-fraction-digits="0" :disabled="documentLocked || !isCreditSale" />
            </label>
            <label class="field">
              <span>วันครบกำหนด</span>
              <InputText v-model="dueDate" type="date" :disabled="documentLocked || !isCreditSale" />
            </label>
            <label class="field">
              <span>ประเภทการส่ง</span>
              <Select v-model="sendType" :options="sendTypeOptions" option-label="label" option-value="value" :disabled="documentLocked" />
            </label>
            <label class="field entity-field">
              <span>ลูกค้า</span>
              <div class="entity-picker">
                <InputText :model-value="customerDisplay" readonly :disabled="documentLocked" @click="openCustomerDialog" />
                <Button icon="pi pi-search" outlined :disabled="documentLocked" aria-label="ค้นหาลูกค้า" @click="openCustomerDialog" />
                <Button icon="pi pi-times" text severity="secondary" :disabled="documentLocked" aria-label="ใช้ลูกค้าทั่วไป" @click="selectWalkIn" />
              </div>
            </label>
            <label class="field entity-field">
              <span>พนักงานขาย</span>
              <div class="entity-picker">
                <InputText :model-value="employeeDisplay || 'ยังไม่ได้เลือกพนักงานขาย'" readonly :disabled="documentLocked" @click="openEmployeeDialog" />
                <Button icon="pi pi-search" outlined :disabled="documentLocked" aria-label="ค้นหาพนักงานขาย" @click="openEmployeeDialog" />
                <Button icon="pi pi-times" text severity="secondary" :disabled="documentLocked" aria-label="ใช้พนักงานเริ่มต้น" @click="resetEmployeeToDefault" />
              </div>
            </label>
            <label class="field">
              <span>วันที่ส่ง</span>
              <InputText v-model="sendDate" type="date" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>วันที่รับ/ส่งสินค้า</span>
              <InputText v-model="deliveryDate" type="date" :disabled="documentLocked" />
            </label>
            <label class="field entity-field">
              <span>ขนส่ง</span>
              <Select v-model="transportType" :options="transportTypes" option-label="label" placeholder="เลือกประเภทขนส่ง" :disabled="documentLocked" show-clear filter />
            </label>
            <template v-if="showDocumentCurrency">
              <label class="field">
                <span>รหัสสกุลเงิน</span>
                <Select v-model="documentCurrency" :options="currencyTypes" option-label="label" placeholder="สกุลเงิน" :disabled="documentLocked" filter />
              </label>
              <label class="field">
                <span>อัตราแลกเปลี่ยน</span>
                <InputNumber v-model="documentExchangeRate" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="6" :disabled="documentLocked" />
              </label>
              <label class="field">
                <span>มูลค่าสุทธิ (สกุลเงิน)</span>
                <InputNumber :model-value="documentCurrencyAmount" input-class="text-right" :min-fraction-digits="2" :max-fraction-digits="2" disabled />
              </label>
              <label class="field">
                <span>สกุลเงิน</span>
                <InputText :model-value="selectedDocumentCurrency?.code || '-'" disabled />
              </label>
            </template>
            <label class="field wide">
              <span>หมายเหตุ</span>
              <Textarea v-model.trim="remark" rows="2" auto-resize :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>หมายเหตุ 2</span>
              <InputText v-model.trim="remark2" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>หมายเหตุ 3</span>
              <InputText v-model.trim="remark3" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>หมายเหตุ 4</span>
              <InputText v-model.trim="remark4" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>หมายเหตุ 5</span>
              <InputText v-model.trim="remark5" :disabled="documentLocked" />
            </label>
          </div>
          <Message v-if="isCreditSale" class="credit-check-message" :severity="customerCreditExceeded || customerCreditClosed ? 'warn' : 'info'" :closable="false">
            <span v-if="customerCreditLoading">กำลังตรวจสอบเครดิตลูกค้า...</span>
            <span v-else-if="customerCreditError">{{ customerCreditError }}</span>
            <span v-else>
              เครดิตลูกค้า {{ formatCurrency(customerCreditBalance) }} / วงเงิน {{ customerCreditLimit ? formatCurrency(customerCreditLimit) : '-' }}
              <template v-if="customerCreditExceeded"> · ยอดหลังขายจะเกินวงเงิน {{ formatCurrency(customerCreditAfterSale) }}</template>
              <template v-if="customerCreditClosed"> · ลูกค้าถูกปิดสถานะเครดิต</template>
            </span>
          </Message>
        </section>

        <section class="biz-panel additional-panel">
          <div class="panel-title">
            <i class="pi pi-folder-open" />
            <strong>รายละเอียดเพิ่มเติม</strong>
          </div>
          <div class="extra-doc-grid">
            <div class="extra-doc-block">
              <h3>ภาษีมูลค่าเพิ่ม</h3>
              <div class="extra-grid-2">
                <label class="field">
                  <span>เลขที่ใบกำกับภาษี</span>
                  <InputText v-model.trim="taxDocNo" :disabled="documentLocked" placeholder="ว่าง = ใช้เลขเอกสาร" />
                </label>
                <label class="field">
                  <span>วันที่ใบกำกับภาษี</span>
                  <InputText v-model="taxDocDate" type="date" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>เลขประจำตัวผู้เสียภาษี</span>
                  <InputText v-model.trim="vatSaleTaxNo" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>สาขาภาษี</span>
                  <InputText v-model.trim="vatSaleBranchCode" :disabled="documentLocked" />
                </label>
                <label class="field wide-local">
                  <span>รายละเอียด</span>
                  <InputText v-model.trim="vatSaleDescription" :disabled="documentLocked" />
                </label>
              </div>
            </div>

            <div class="extra-doc-block">
              <h3>การจัดส่ง</h3>
              <div class="extra-grid-2">
                <label class="field wide-local">
                  <span>ค้นหาที่อยู่จัดส่ง</span>
                  <Select :model-value="selectedShippingLabel" :options="shippingLabels" option-label="label" placeholder="เลือกที่อยู่จัดส่ง" :disabled="documentLocked" show-clear filter @update:model-value="applyShippingLabel" />
                </label>
                <label class="field">
                  <span>ชื่อผู้รับ/ขนส่ง</span>
                  <InputText v-model.trim="shipment.transport_name" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>โทรศัพท์</span>
                  <InputText v-model.trim="shipment.transport_telephone" :disabled="documentLocked" />
                </label>
                <label class="field wide-local">
                  <span>ที่อยู่</span>
                  <Textarea v-model.trim="shipment.transport_address" rows="2" auto-resize :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>จังหวัด</span>
                  <InputText v-model.trim="shipment.transport_province" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>อำเภอ</span>
                  <InputText v-model.trim="shipment.transport_amper" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>ตำบล</span>
                  <InputText v-model.trim="shipment.transport_tambon" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>รหัสไปรษณีย์</span>
                  <InputText v-model.trim="shipment.zipcode" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>Ship Code</span>
                  <InputText v-model.trim="shipment.ship_code" :disabled="documentLocked" />
                </label>
                <label class="field">
                  <span>ปลายทาง</span>
                  <InputText v-model.trim="shipment.destination" :disabled="documentLocked" />
                </label>
              </div>
            </div>

            <div class="extra-doc-block">
              <h3>ภาษีหัก ณ ที่จ่าย</h3>
              <div class="extra-inline-form">
                <InputText v-model.trim="whtIncomeType" placeholder="ประเภท/รหัส" :disabled="documentLocked" />
                <InputNumber v-model="whtAmount" input-class="text-right" placeholder="ยอดฐาน" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
                <InputNumber v-model="whtRate" input-class="text-right" placeholder="%" :min="0" :max-fraction-digits="2" :disabled="documentLocked" />
                <Button icon="pi pi-plus" outlined :disabled="documentLocked || whtAmount <= 0" @click="addWhtRow" />
              </div>
              <div v-if="whtRows.length" class="mini-table">
                <div v-for="row in whtRows" :key="row.id" class="mini-row">
                  <span>{{ row.income_type || '-' }}</span>
                  <span>{{ formatCurrency(row.amount) }}</span>
                  <span>{{ formatQty(row.tax_rate) }}%</span>
                  <strong>{{ formatCurrency(row.tax_value) }}</strong>
                  <Button icon="pi pi-trash" text rounded severity="danger" :disabled="documentLocked" @click="removeWhtRow(row.id)" />
                </div>
                <div class="mini-row total">
                  <span>รวม</span>
                  <span>{{ formatCurrency(whtTotalAmount) }}</span>
                  <span></span>
                  <strong>{{ formatCurrency(whtTotalTax) }}</strong>
                  <span></span>
                </div>
              </div>
            </div>

            <div class="extra-doc-block">
              <h3>GL</h3>
              <div class="extra-inline-form gl-form">
                <Select v-model="manualGlAccount" :options="glAccounts" option-label="label" placeholder="บัญชี" :disabled="documentLocked" filter />
                <InputNumber v-model="manualGlDebit" input-class="text-right" placeholder="เดบิต" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
                <InputNumber v-model="manualGlCredit" input-class="text-right" placeholder="เครดิต" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
                <Button icon="pi pi-plus" outlined :disabled="documentLocked || !manualGlAccount || (manualGlDebit <= 0 && manualGlCredit <= 0)" @click="addManualGlRow" />
              </div>
              <div v-if="manualGlRows.length" class="mini-table">
                <div v-for="row in manualGlRows" :key="row.id" class="mini-row gl-row">
                  <span>{{ row.account_code }} {{ row.account_name }}</span>
                  <span>{{ formatCurrency(row.debit) }}</span>
                  <span>{{ formatCurrency(row.credit) }}</span>
                  <Button icon="pi pi-trash" text rounded severity="danger" :disabled="documentLocked" @click="removeManualGlRow(row.id)" />
                </div>
                <div class="mini-row total gl-row" :class="{ warning: !manualGlBalanced }">
                  <span>รวม</span>
                  <strong>{{ formatCurrency(manualGlDebitTotal) }}</strong>
                  <strong>{{ formatCurrency(manualGlCreditTotal) }}</strong>
                  <span></span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="biz-panel product-panel">
          <div class="panel-title">
            <i class="pi pi-box" />
            <strong>เพิ่มสินค้า</strong>
          </div>
          <div class="product-tools">
            <div class="tool-input">
              <InputText v-model.trim="productSearch" data-testid="sale-product-search" placeholder="ค้นหาสินค้า / รหัส / ชื่อ" :disabled="documentLocked" @keyup.enter="searchProducts" />
              <Button icon="pi pi-search" :loading="productLoading" outlined :disabled="documentLocked" aria-label="ค้นหาสินค้า" @click="searchProducts" />
            </div>
            <div class="tool-input">
              <InputText ref="barcodeRef" v-model.trim="barcodeInput" data-testid="sale-barcode-input" placeholder="[จำนวน*]บาร์โค้ด เช่น 3*885..." :disabled="documentLocked || barcodeAdding" @keyup.enter="addBarcode" />
              <Button icon="pi pi-barcode" :loading="barcodeAdding" outlined :disabled="documentLocked" aria-label="เพิ่มด้วยบาร์โค้ด" @click="addBarcode" />
            </div>
            <div class="product-action-buttons">
              <Button icon="pi pi-shopping-cart" label="ตะกร้าสินค้า" severity="success" :disabled="documentLocked" @click="productBasketVisible = true" />
            </div>
          </div>
        </section>

        <section class="biz-panel lines-panel">
          <div class="panel-title lines-title">
            <span><i class="pi pi-list" /> <strong>รายการสินค้า</strong></span>
            <span>{{ validRows.length }} รายการ</span>
          </div>
          <div class="lines-table-wrap">
            <table class="lines-table">
              <colgroup>
                <col class="line-col-index">
                <col class="line-col-item">
                <col class="line-col-code">
                <col class="line-col-unit">
                <col class="line-col-location">
                <col class="line-col-qty">
                <col class="line-col-price">
                <col class="line-col-discount">
                <col class="line-col-total">
                <col class="line-col-note">
                <col class="line-col-action">
              </colgroup>
              <thead>
                <tr>
                  <th class="num">#</th>
                  <th>สินค้า</th>
                  <th>รหัส</th>
                  <th>หน่วย</th>
                  <th>คลัง/ที่เก็บ</th>
                  <th class="num">จำนวน</th>
                  <th class="num">ราคา</th>
                  <th class="num">ส่วนลด</th>
                  <th class="num">รวม</th>
                  <th>หมายเหตุ</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="(line, index) in rows" :key="line.id" :class="{ 'row-warning': line.price_error }">
                  <td class="line-index num">{{ index + 1 }}</td>
                  <td class="item-name">
                    <div class="line-name-row">
                      <strong>{{ line.item_name }}</strong>
                      <Button
                        v-if="lineHasPromotionGuide(line)"
                        icon="pi pi-tag"
                        class="line-pro-button"
                        size="small"
                        severity="danger"
                        
                        :disabled="promotionGuideLoading"
                        v-tooltip.top="'โปรแนะนำ'"
                        @click="openPromotionGuideDialog(line)"
                      />
                    </div>
                    <small v-if="line.price_loading">กำลังดึงราคา...</small>
                    <small v-else-if="line.price_error" class="line-error">{{ line.price_error }}</small>
                  </td>
                  <td>{{ line.item_code }}</td>
                  <td>{{ line.unit_code }}</td>
                  <td class="line-location-cell">
                    <div class="line-location-selects">
                      <Select
                        :model-value="line.wh_code"
                        :options="warehouseSelectOptions"
                        option-label="label"
                        option-value="code"
                        placeholder="คลัง"
                        :disabled="documentLocked"
                        @update:model-value="value => setLineWarehouse(line, value)"
                      />
                      <Select
                        :model-value="line.shelf_code"
                        :options="shelfSelectOptions(line.wh_code)"
                        option-label="label"
                        option-value="code"
                        placeholder="ที่เก็บ"
                        :disabled="documentLocked || !line.wh_code"
                        @update:model-value="value => setLineShelf(line, value)"
                      />
                    </div>
                  </td>
                  <td class="qty-cell">
                    <div class="line-qty-stepper">
                      <Button icon="pi pi-minus" text rounded severity="secondary" :disabled="documentLocked || toNumber(line.qty) <= 0" aria-label="ลดจำนวน" @click="adjustLineQty(line, -1)" />
                      <InputNumber
                        :model-value="line.qty"
                        input-class="line-qty-input text-right"
                        :min="0"
                        :min-fraction-digits="0"
                        :max-fraction-digits="2"
                        :disabled="documentLocked"
                        @update:model-value="value => setLineQty(line, value)"
                      />
                      <Button icon="pi pi-plus" text rounded severity="secondary" :disabled="documentLocked" aria-label="เพิ่มจำนวน" @click="adjustLineQty(line, 1)" />
                    </div>
                  </td>
                  <td class="price-cell">
                    <button type="button" class="line-price-button" :disabled="documentLocked || line.price_loading" @click="openPriceEditor(line)">
                      <span>{{ formatCurrency(line.price) }}</span>
                      <i class="pi pi-pencil" />
                    </button>
                  </td>
                  <td><InputText v-model.trim="line.discount" class="cell-input line-discount-input text-right" placeholder="0 หรือ %" :disabled="documentLocked" /></td>
                  <td class="num strong">{{ formatCurrency(lineSumAmount(line)) }}</td>
                  <td class="note-cell">
                    <Button
                      :icon="line.remark ? 'pi pi-comment' : 'pi pi-comment'"
                      text
                      rounded
                      :severity="line.remark ? 'info' : 'secondary'"
                      :aria-label="line.remark ? line.remark : 'เพิ่มหมายเหตุ'"
                      :disabled="documentLocked"
                      @click="openRemarkEditor(line)"
                    />
                  </td>
                  <td class="action-cell">
                    <Button icon="pi pi-trash" text rounded severity="danger" aria-label="ลบรายการ" :disabled="documentLocked" @click="removeLine(index)" />
                  </td>
                </tr>
                <tr v-if="!rows.length">
                  <td colspan="11" class="empty-lines">ค้นหา/ยิงบาร์โค้ดเพื่อเพิ่มรายการสินค้า</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      <aside class="summary-sidebar">
        <section class="biz-panel totals-card">
          <div class="panel-title">
            <i class="pi pi-calculator" />
            <strong>สรุปยอด</strong>
          </div>
          <label class="field">
            <span>ส่วนลดท้ายบิล</span>
            <InputText v-model.trim="discountWord" data-testid="sale-bill-discount" placeholder="เช่น 10%, 500" :disabled="documentLocked" />
          </label>
          <div class="summary-list">
            <div><span>ยอดรวมสินค้า</span><strong>{{ formatCurrency(totals.totalValue) }}</strong></div>
            <div v-if="billDiscountAmount > 0"><span>ส่วนลดท้ายบิล</span><strong class="discount">-{{ formatCurrency(billDiscountAmount) }}</strong></div>
            <div v-if="promotionDiscountAmount > 0"><span>โปรโมชั่น</span><strong class="discount">-{{ formatCurrency(promotionDiscountAmount) }}</strong></div>
            <div><span>ยอดก่อนภาษี</span><strong>{{ formatCurrency(totals.beforeVat) }}</strong></div>
            <div><span>VAT</span><strong>{{ totals.vatValue > 0 ? formatCurrency(totals.vatValue) : '-' }}</strong></div>
            <div class="net"><span>ยอดสุทธิ</span><strong>{{ formatCurrency(totals.totalAmount) }}</strong></div>
          </div>

          <div class="promotion-panel" :class="promotionStatusClass">
            <div class="promotion-panel-head">
              <div>
                <span>สถานะโปรโมชั่น</span>
                <strong>{{ promotionStatusText }}</strong>
                <small v-if="promotionLastCalculatedAt">คำนวณล่าสุด {{ promotionLastCalculatedAt }}</small>
              </div>
              <Button
                label="คำนวณใหม่"
                icon="pi pi-refresh"
                size="small"
                outlined
                :loading="promotionLoading"
                :disabled="documentLocked || !validRows.length || priceRefreshing"
                @click="recalculatePromotionNow"
              />
            </div>

            <Message v-if="promotionError" severity="error" :closable="false">
              ยังบันทึกไม่ได้ เพราะยังคำนวณโปรโมชั่นไม่สำเร็จ: {{ promotionError }}
            </Message>
            <Message
              v-else-if="promotionStatus === 'success' && !promotionAuditRows.length"
              severity="info"
              :closable="false"
            >
              คำนวณโปรโมชั่นแล้ว ไม่พบโปรโมชั่นที่เข้าเงื่อนไข
            </Message>

            <div v-if="promotionAuditRows.length" class="promotion-audit-list">
              <article v-for="promotion in promotionAuditRows" :key="promotion.key" class="promotion-audit-card">
                <div class="promotion-audit-main">
                  <div>
                    <span class="promotion-code">{{ promotion.code || '-' }}</span>
                    <strong>{{ promotion.name }}</strong>
                  </div>
                  <strong class="discount">-{{ formatCurrency(promotion.amount) }}</strong>
                </div>
                <div class="promotion-audit-meta">
                  <span>จำนวนครั้ง {{ formatQty(promotion.qty || promotion.count || 0) }}</span>
                  <span>ยอดลด {{ formatCurrency(promotion.amount) }}</span>
                </div>
                <div class="promotion-related">
                  <span>สินค้าที่เกี่ยวข้อง</span>
                  <div v-if="promotion.relatedItems.length" class="promotion-related-list">
                    <small v-for="item in promotion.relatedItems" :key="`${promotion.key}-${item.item_code}-${item.unit_code}`">
                      {{ item.item_code }} {{ item.item_name }} / {{ item.unit_code || '-' }} x {{ formatQty(item.qty) }}
                    </small>
                  </div>
                  <small v-else class="promotion-related-empty">ยังไม่มีรายละเอียดสินค้าจากผลลัพธ์โปรโมชั่น</small>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section v-if="isCashSale" class="biz-panel payment-card">
          <div class="panel-title">
            <i class="pi pi-wallet" />
            <strong>รับชำระเงิน</strong>
          </div>

          <div class="payment-detail-panel">
            <div class="payment-detail-head">
              <strong>รายละเอียดการชำระเงิน</strong>
              <span>{{ paymentEntries.length }} รายการ</span>
            </div>
            <div class="payment-detail-grid">
              <div
                v-for="row in paymentDetailRows"
                :key="row.label"
                :class="['payment-detail-row', { strong: row.strong, muted: row.muted, attention: row.attention }]"
              >
                <span>{{ row.label }}</span>
                <strong>{{ formatCurrency(row.amount) }}</strong>
              </div>
            </div>
            <div v-if="paymentBreakdownRows.length" class="payment-breakdown">
              <span v-for="row in paymentBreakdownRows" :key="row.key">
                {{ row.label }} <b>{{ formatCurrency(row.amount) }}</b>
              </span>
            </div>
          </div>

          <div class="pay-tabs">
            <button
              v-for="tab in visiblePaymentTypeOptions"
              :key="tab.value"
              type="button"
              :class="{ active: activePayType === tab.value }"
              :disabled="documentLocked"
              @click="activePayType = tab.value"
            >
              <i :class="tab.icon" />
              {{ tab.label }}
            </button>
          </div>

          <div v-if="activePayType === 'cash'" class="pay-form">
            <div class="cash-currency-grid">
              <label class="field">
                <span>สกุลเงิน</span>
                <Select
                  :model-value="cashCurrencyCode"
                  :options="cashCurrencyOptions"
                  option-label="label"
                  option-value="value"
                  :disabled="documentLocked"
                  @update:model-value="changeCashCurrency"
                />
              </label>
              <label class="field">
                <span>จำนวนรับ</span>
                <InputNumber v-model="cashCurrencyAmount" input-class="text-right" :min="0" :min-fraction-digits="0" :max-fraction-digits="2" :disabled="documentLocked" />
              </label>
              <label class="field">
                <span>อัตราเป็นบาท</span>
                <InputNumber v-model="cashExchangeRate" input-class="text-right" :min="0" :min-fraction-digits="0" :max-fraction-digits="6" :disabled="documentLocked || cashCurrencyCode === 'THB'" />
              </label>
            </div>
            <div class="cash-converted-preview">
              <span>คิดเป็นเงินบาท</span>
              <strong>{{ formatCurrency(cashConvertedAmount) }}</strong>
            </div>
            <Button label="เพิ่มเงินสด" icon="pi pi-plus" size="small" :disabled="documentLocked || cashConvertedAmount <= 0 || cashExchangeRate <= 0" @click="addCash" />
          </div>

          <div v-else-if="activePayType === 'transfer'" class="pay-form">
            <label class="field">
              <span>สมุดบัญชี</span>
              <Select v-model="transferPassBook" :options="passBooks" option-label="label" placeholder="เลือกบัญชี" :disabled="documentLocked" filter />
            </label>
            <div v-if="transferPassBook" class="payment-master-note">
              <span>{{ transferPassBook.bank_name || transferPassBook.bank_code || '-' }}</span>
              <span>สาขา {{ transferPassBook.branch_name || transferPassBook.bank_branch || '-' }}</span>
              <span>สกุลเงิน {{ transferPassBook.currency_code || 'THB' }}</span>
            </div>
            <label class="field">
              <span>วันที่โอน</span>
              <InputText v-model="transferDate" type="date" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>จำนวนเงินโอน</span>
              <InputNumber v-model="transferInputAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มโอน" icon="pi pi-plus" size="small" :disabled="documentLocked || !transferPassBook || transferInputAmount <= 0" @click="addTransfer" />
          </div>

          <div v-else-if="activePayType === 'credit'" class="pay-form">
            <label class="field">
              <span>ประเภทบัตร</span>
              <Select v-model="creditType" :options="creditTypes" option-label="label" placeholder="เลือกประเภทบัตร" :disabled="documentLocked" filter />
            </label>
            <div class="payment-master-note">
              <span>Charge {{ formatCurrency(creditChargePreview) }}</span>
              <span>ยอดรวมบัตร {{ formatCurrency(creditTotalPreview) }}</span>
              <span v-if="creditType">อัตรา {{ creditType.charge_rate_word || creditType.charge_rate || '0' }}</span>
            </div>
            <label class="field">
              <span>เลขบัตร/Ref</span>
              <InputText v-model.trim="creditCardNumber" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>อนุมัติ</span>
              <InputText v-model.trim="creditApprovalNo" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="creditInputAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มบัตร" icon="pi pi-plus" size="small" :disabled="documentLocked || !creditCardNumber || creditInputAmount <= 0" @click="addCredit" />
          </div>

          <div v-else-if="activePayType === 'cheque'" class="pay-form">
            <label class="field">
              <span>สมุดบัญชี</span>
              <Select v-model="chequePassBook" :options="passBooks" option-label="label" placeholder="เลือกบัญชี" :disabled="documentLocked" filter />
            </label>
            <div v-if="chequePassBook" class="payment-master-note">
              <span>{{ chequePassBook.bank_name || chequePassBook.bank_code || '-' }}</span>
              <span>สาขา {{ chequePassBook.branch_name || chequePassBook.bank_branch || '-' }}</span>
              <span>สกุลเงิน {{ chequePassBook.currency_code || 'THB' }}</span>
            </div>
            <label class="field">
              <span>เลขที่เช็ค</span>
              <InputText v-model.trim="chequeNumber" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>วันที่เช็ค</span>
              <InputText v-model="chequeDueDate" type="date" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="chequeAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มเช็ค" icon="pi pi-plus" size="small" :disabled="documentLocked || !chequeNumber || chequeAmount <= 0" @click="addCheque" />
          </div>

          <div v-else-if="activePayType === 'petty'" class="pay-form">
            <label class="field">
              <span>รหัสเงินสดย่อย</span>
              <Select v-model="pettyCashAccount" :options="pettyCashList" option-label="label" placeholder="เลือกเงินสดย่อย" :disabled="documentLocked" filter />
            </label>
            <div v-if="pettyCashAccount" class="payment-master-note">
              <span>{{ pettyCashAccount.name_1 || pettyCashAccount.code }}</span>
              <span>สกุลเงิน {{ pettyCashAccount.currency_code || 'THB' }}</span>
              <span>คงเหลือ {{ formatCurrency(pettyCashAccount.balance_money || 0) }}</span>
            </div>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="pettyCashAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มเงินสดย่อย" icon="pi pi-plus" size="small" :disabled="documentLocked || !pettyCashAccount || pettyCashAmount <= 0" @click="addPettyCash" />
          </div>

          <div v-else-if="activePayType === 'deposit'" class="pay-form">
            <label class="field wide">
              <span>เลขที่เงินล่วงหน้า</span>
              <Select v-model="depositDoc" :options="depositOptions" option-label="label" placeholder="เลือกเอกสารเงินล่วงหน้า" :disabled="documentLocked" filter @show="refreshDepositOptions" />
            </label>
            <div v-if="depositDoc" class="payment-master-note">
              <span>{{ depositDoc.doc_no }}</span>
              <span>ยอดเอกสาร {{ formatCurrency(depositDoc.amount || depositDoc.total_amount || 0) }}</span>
              <span>คงเหลือ {{ formatCurrency(depositDoc.balance_amount || 0) }}</span>
            </div>
            <label class="field">
              <span>ยอดตัด</span>
              <InputNumber v-model="depositAmount" input-class="text-right" :min="0" :max="toNumber(depositDoc?.balance_amount)" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked || !depositDoc" />
            </label>
            <Button label="เพิ่มเงินล่วงหน้า" icon="pi pi-plus" size="small" :disabled="documentLocked || !depositDoc || depositAmount <= 0 || depositAmount > toNumber(depositDoc?.balance_amount)" @click="addDeposit" />
          </div>

          <div v-else-if="activePayType === 'coupon'" class="pay-form">
            <label class="field wide">
              <span>เลขที่คูปอง</span>
              <Select v-model="couponSelected" :options="couponOptions" option-label="label" placeholder="เลือกคูปอง" :disabled="documentLocked" filter @show="refreshCouponOptions" />
            </label>
            <div v-if="couponSelected" class="payment-master-note">
              <span>{{ couponSelected.number }}</span>
              <span>ใช้ได้ {{ formatCurrency(couponSelected.available_amount ?? couponSelected.balance_amount ?? couponSelected.amount) }}</span>
              <span v-if="couponSelected.date_expire">หมดอายุ {{ couponSelected.date_expire }}</span>
            </div>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="couponAmount" input-class="text-right" :min="0" :max="toNumber(couponSelected?.available_amount ?? couponSelected?.usable_amount ?? couponSelected?.balance_amount)" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked || !couponSelected" />
            </label>
            <Button label="เพิ่มคูปอง" icon="pi pi-plus" size="small" :disabled="documentLocked || !couponSelected || couponAmount <= 0 || couponAmount > toNumber(couponSelected?.available_amount ?? couponSelected?.usable_amount ?? couponSelected?.balance_amount)" @click="addCoupon" />
          </div>

          <div v-else-if="activePayType === 'income'" class="pay-form">
            <label class="field">
              <span>รหัสรายได้</span>
              <Select v-model="incomeType" :options="incomeTypes" option-label="label" placeholder="เลือกรายได้" :disabled="documentLocked" filter />
            </label>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="incomeAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มรายได้" icon="pi pi-plus" size="small" :disabled="documentLocked || !incomeType || incomeAmount <= 0" @click="addIncome" />
          </div>

          <div v-else-if="activePayType === 'expense'" class="pay-form">
            <label class="field">
              <span>รหัสค่าใช้จ่าย</span>
              <Select v-model="expenseType" :options="expenseTypes" option-label="label" placeholder="เลือกค่าใช้จ่าย" :disabled="documentLocked" filter />
            </label>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="expenseAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่มค่าใช้จ่าย" icon="pi pi-plus" size="small" :disabled="documentLocked || !expenseType || expenseAmount <= 0" @click="addExpense" />
          </div>

          <div v-else-if="activePayType === 'currency'" class="pay-form">
            <label class="field">
              <span>สกุลเงิน</span>
              <Select v-model="otherCurrency" :options="currencyTypes" option-label="label" placeholder="เลือกสกุลเงิน" :disabled="documentLocked" filter />
            </label>
            <div v-if="otherCurrency" class="payment-master-note">
              <span>{{ otherCurrency.code }} {{ otherCurrency.name_1 || '' }}</span>
              <span>อัตรา {{ formatQty(otherCurrencyRate) }}</span>
            </div>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="otherCurrencyAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>Charge</span>
              <InputNumber v-model="otherCurrencyCharge" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <div class="cash-converted-preview">
              <span>ยอดเงินบาท</span>
              <strong>{{ formatCurrency(otherCurrencyConvertedAmount) }}</strong>
            </div>
            <Button label="เพิ่มสกุลเงินอื่นๆ" icon="pi pi-plus" size="small" :disabled="documentLocked || !otherCurrency || otherCurrencyRate <= 0" @click="addOtherCurrency" />
          </div>

          <div v-else-if="activePayType === 'wallet'" class="pay-form">
            <label class="field">
              <span>ประเภท Wallet</span>
              <Select v-model="walletType" :options="walletTypes" option-label="label" placeholder="เลือก Wallet" :disabled="documentLocked" filter />
            </label>
            <div v-if="walletType" class="payment-master-note">
              <span>{{ walletType.code }}</span>
              <span>{{ walletType.name_1 || walletType.label }}</span>
              <span v-if="walletType.account_code">บัญชี {{ walletType.account_code }}</span>
            </div>
            <label class="field">
              <span>เลขที่รายการ</span>
              <InputText v-model.trim="walletNumber" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>เลขที่อนุมัติ</span>
              <InputText v-model.trim="walletApprovedNo" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>Ref 1</span>
              <InputText v-model.trim="walletRef1" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>Ref 2</span>
              <InputText v-model.trim="walletRef2" :disabled="documentLocked" />
            </label>
            <label class="field">
              <span>จำนวนเงิน</span>
              <InputNumber v-model="walletAmount" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
            </label>
            <Button label="เพิ่ม Wallet" icon="pi pi-plus" size="small" :disabled="documentLocked || !walletNumber || walletAmount <= 0" @click="addWallet" />
          </div>

          <div class="payment-list">
            <div v-if="!paymentEntries.length" class="payment-empty">ยังไม่มีรายการชำระเงิน</div>
            <div v-for="entry in paymentEntries" :key="entry.id" class="payment-row">
              <div>
                <strong>{{ entry.label }}</strong>
                <span>{{ paymentEntryDescription(entry) }}</span>
              </div>
              <b>{{ formatCurrency(paymentEntryAmount(entry)) }}</b>
              <Button icon="pi pi-times" text rounded severity="danger" aria-label="ลบชำระเงิน" :disabled="documentLocked" @click="removePayment(entry.id)" />
            </div>
          </div>

          <label class="field">
            <span>ปัดเศษ/ส่วนต่าง</span>
            <InputNumber v-model="roundedAmount" input-class="text-right" :min-fraction-digits="2" :max-fraction-digits="2" :disabled="documentLocked" />
          </label>
          <div class="payment-summary">
            <div><span>รับแล้ว</span><strong>{{ formatCurrency(totalPaid) }}</strong></div>
            <div><span>{{ paymentChange > 0 ? 'เงินทอน' : 'คงเหลือ' }}</span><strong>{{ formatCurrency(paymentChange > 0 ? paymentChange : remainingPayment) }}</strong></div>
          </div>

          <Message v-if="paymentReviewNeeded" severity="warn" :closable="false">
            ยอดเอกสารเปลี่ยนหลังมีรายการชำระเงิน กรุณาตรวจสอบยอดรับชำระก่อนบันทึก
            <Button label="ยืนยันยอดชำระถูกต้อง" size="small" text :disabled="documentLocked" @click="confirmPaymentReview" />
          </Message>
          <Message v-if="!cashChangeAllowed" severity="error" :closable="false">
            เงินทอนต้องมาจากยอดรับเงินสดเท่านั้น
          </Message>

          <div v-if="validationMessages.length" class="save-warnings">
            <span v-for="message in validationMessages" :key="message">{{ message }}</span>
          </div>
          <Button class="save-btn" :label="successDocNo ? 'บันทึกแล้ว' : 'บันทึกเอกสารขาย'" icon="pi pi-save" :loading="saving" :disabled="!canSave || !!successDocNo" @click="saveDocument" />
        </section>
        <section v-else class="biz-panel payment-card credit-sale-card">
          <div class="panel-title">
            <i class="pi pi-file-check" />
            <strong>ขายเชื่อ</strong>
          </div>
          <Message severity="info" :closable="false">
            เอกสารขายเชื่อจะไม่เปิดรับชำระเงิน และจะไม่บันทึกรายการรับเงินในเอกสารนี้
          </Message>
          <div v-if="validationMessages.length" class="save-warnings">
            <span v-for="message in validationMessages" :key="message">{{ message }}</span>
          </div>
          <Button class="save-btn" :label="successDocNo ? 'บันทึกแล้ว' : 'บันทึกเอกสารขาย'" icon="pi pi-save" :loading="saving" :disabled="!canSave || !!successDocNo" @click="saveDocument" />
        </section>
      </aside>
    </div>

    <Dialog
      :visible="creditApproveDialogVisible"
      header="อนุมัติวงเงินเครดิต"
      modal
      :draggable="false"
      :style="{ width: 'min(460px, 94vw)' }"
      @update:visible="creditApproveDialogVisible = $event"
    >
      <div class="credit-approve-dialog">
        <Message severity="warn" :closable="false">{{ creditApproveMessage }}</Message>
        <ul v-if="creditApproveDetails.length">
          <li v-for="detail in creditApproveDetails" :key="detail">{{ detail }}</li>
        </ul>
        <label>
          <span>ผู้อนุมัติ</span>
          <InputText v-model.trim="creditApproveUser" autocomplete="off" autofocus />
        </label>
        <label>
          <span>รหัสผ่าน</span>
          <InputText v-model="creditApprovePassword" type="password" autocomplete="current-password" @keyup.enter="submitCreditApprove" />
        </label>
      </div>
      <template #footer>
        <Button label="ยกเลิก" severity="secondary" text @click="creditApproveDialogVisible = false" />
        <Button label="อนุมัติและบันทึก" icon="pi pi-check" severity="warning" :loading="saving" @click="submitCreditApprove" />
      </template>
    </Dialog>

    <Dialog
      :visible="saveDialogVisible"
      :header="saveDialogTitle"
      modal
      :draggable="false"
      :style="{ width: 'min(520px, 94vw)' }"
      @update:visible="saveDialogVisible = $event"
    >
      <div class="save-feedback-dialog" :class="`is-${saveDialogType}`">
        <div class="save-feedback-icon">
          <i :class="saveDialogIcon" />
        </div>
        <div class="save-feedback-content">
          <p>{{ saveDialogMessage }}</p>
          <ul v-if="saveDialogDetails.length">
            <li v-for="detail in saveDialogDetails" :key="detail">{{ detail }}</li>
          </ul>
        </div>
      </div>
      <template #footer>
        <Button
          v-if="saveDialogPrimaryAction"
          :label="saveDialogPrimaryLabel || 'ดำเนินการต่อ'"
          icon="pi pi-check"
          :severity="saveDialogPrimarySeverity"
          @click="runSaveDialogPrimaryAction"
        />
        <Button
          v-if="saveDialogType === 'warn' && paymentReviewNeeded"
          label="ยืนยันยอดชำระถูกต้อง"
          icon="pi pi-check"
          severity="warning"
          outlined
          @click="confirmPaymentReview(); saveDialogVisible = false"
        />
        <Button
          v-if="saveDialogType === 'success' && successDocNo"
          label="เอกสารใหม่"
          icon="pi pi-plus"
          severity="secondary"
          outlined
          @click="newDocument"
        />
        <Button
          v-if="saveDialogType === 'success' && successDocNo"
          label="พิมพ์ฟอร์ม"
          icon="pi pi-print"
          @click="saveDialogVisible = false; openPrintDialog()"
        />
        <Button label="ปิด" severity="secondary" text @click="saveDialogVisible = false" />
      </template>
    </Dialog>

    <Dialog
      :visible="promotionGuideDialogVisible"
      header="โปรโมชั่นที่เกี่ยวข้อง"
      modal
      :draggable="false"
      :style="{ width: 'min(820px, 94vw)' }"
      @update:visible="promotionGuideDialogVisible = $event"
    >
      <Accordion v-if="promotionGuideDialogPromotions.length" class="promotion-guide-accordion">
        <AccordionPanel
          v-for="(promotion, index) in promotionGuideDialogPromotions"
          :key="promotion.promotion_code"
          :value="String(index)"
        >
          <AccordionHeader>
            <div class="promotion-guide-accordion-title">
              <strong>{{ promotion.promotion_code }}</strong>
              <span>{{ promotion.promotion_name }}</span>
              <small :class="{ active: promotion.is_applied }">
                {{ promotion.is_applied ? 'เข้าเงื่อนไขแล้ว' : 'ยังไม่เข้าเงื่อนไข' }}
              </small>
            </div>
          </AccordionHeader>
          <AccordionContent>
            <div class="promotion-guide-card">
              <section class="promotion-guide-section">
                <span class="promotion-guide-section-title" style="color:darkgreen">สินค้าเงื่อนไข</span>
                <div v-if="promotion.condition_items?.length" class="promotion-guide-items">
                  <div
                    v-for="item in promotion.condition_items"
                    :key="`${promotion.promotion_code}-condition-${item.item_code}-${item.unit_code}-${item.group_number}`"
                    class="promotion-guide-item"
                    :class="{ matched: item.is_in_cart }"
                  >
                    <strong>{{ item.item_code }}</strong>
                    <span>{{ item.item_name || '-' }}</span>
                    <small>
                      {{ item.unit_code || '-' }}
                      <template v-if="toNumber(item.required_qty) > 0"> · เงื่อนไข {{ formatQty(item.required_qty) }}</template>
             
                    </small>
                  </div>
                </div>
                <div v-else class="promotion-guide-empty">ไม่มีรายการสินค้าเงื่อนไข</div>
              </section>

              <section class="promotion-guide-section">
                <span class="promotion-guide-section-title" style="color:crimson">สินค้าโปรโมชั่น</span>
                <div v-if="promotion.action_items?.length" class="promotion-guide-items">
                  <div
                    v-for="item in promotion.action_items"
                    :key="`${promotion.promotion_code}-action-${item.item_code}-${item.unit_code}`"
                    class="promotion-guide-item action"
                  >
                    <strong>{{ item.item_code }}</strong>
                    <span>{{ item.item_name || '-' }}</span>
                    <small>
                      {{ item.unit_code || '-' }}
                      <template v-if="toNumber(item.qty) > 0"> · จำนวน {{ formatQty(item.qty) }}</template>
                    </small>
                  </div>
                </div>
                <div v-else class="promotion-guide-empty">โปรโมชั่นนี้เป็นส่วนลด หรือไม่มี action_command รูปแบบรหัสสินค้า,หน่วยนับ</div>
              </section>
            </div>
          </AccordionContent>
        </AccordionPanel>
      </Accordion>
      <div v-else class="empty-lines">ไม่มีโปรโมชั่นที่ใช้งานได้สำหรับสินค้านี้</div>
      <template #footer>
        <Button label="ปิด" severity="secondary" text @click="promotionGuideDialogVisible = false" />
      </template>
    </Dialog>

    <Dialog
      :visible="customerDialogVisible"
      header="ค้นหาลูกค้า"
      modal
      :draggable="false"
      :style="{ width: 'min(720px, 95vw)' }"
      @update:visible="customerDialogVisible = $event"
    >
      <div class="entity-dialog-body">
        <div class="dialog-search-row">
          <InputText v-model.trim="custSearch" data-testid="sale-customer-search" placeholder="รหัสลูกค้า / ชื่อลูกค้า" autofocus :disabled="documentLocked" @update:model-value="searchCustomers" @keyup.enter="loadCustomers" />
          <Button label="ค้นหา" icon="pi pi-search" :loading="custLoading" :disabled="documentLocked" @click="loadCustomers" />
          <Button label="ลูกค้าทั่วไป" icon="pi pi-refresh" severity="secondary" outlined :disabled="documentLocked" @click="selectWalkIn" />
        </div>
        <div v-if="custLoading" class="lookup-hint">กำลังค้นหา...</div>
        <div v-else-if="custResults.length" class="dialog-result-list">
          <button v-for="customer in custResults" :key="customer.code" type="button" :disabled="documentLocked" @click="selectCustomer(customer)">
            <strong>{{ customer.code }}</strong>
            <span>{{ customer.name || customer.name_1 }}</span>
          </button>
        </div>
        <div v-else class="empty-lines">{{ custSearch ? 'ไม่พบลูกค้า' : 'กรอกคำค้นหาเพื่อค้นหาลูกค้า' }}</div>
      </div>
    </Dialog>

    <Dialog
      :visible="employeeDialogVisible"
      header="ค้นหาพนักงานขาย"
      modal
      :draggable="false"
      :style="{ width: 'min(720px, 95vw)' }"
      @update:visible="employeeDialogVisible = $event"
    >
      <div class="entity-dialog-body">
        <div class="dialog-search-row">
          <InputText v-model.trim="saleSearch" data-testid="sale-employee-search" placeholder="รหัสพนักงาน / ชื่อพนักงาน" autofocus :disabled="documentLocked" @update:model-value="searchEmployees" @keyup.enter="loadEmployees" />
          <Button label="ค้นหา" icon="pi pi-search" :loading="saleLoading" :disabled="documentLocked" @click="loadEmployees" />
          <Button label="พนักงานเริ่มต้น" icon="pi pi-refresh" severity="secondary" outlined :disabled="documentLocked" @click="resetEmployeeToDefault" />
        </div>
        <div v-if="saleLoading" class="lookup-hint">กำลังค้นหา...</div>
        <div v-else-if="saleResults.length" class="dialog-result-list">
          <button v-for="employee in saleResults" :key="employee.code" type="button" :disabled="documentLocked" @click="selectEmployee(employee)">
            <strong>{{ employee.code }}</strong>
            <span>{{ employee.name || employee.name_1 }}</span>
          </button>
        </div>
        <div v-else class="empty-lines">{{ saleSearch ? 'ไม่พบพนักงานขาย' : 'กรอกคำค้นหาเพื่อค้นหาพนักงานขาย' }}</div>
      </div>
    </Dialog>

    <Dialog
      :visible="priceEditorVisible"
      header="แก้ไขราคา"
      modal
      :draggable="false"
      :style="{ width: 'min(380px, 94vw)' }"
      @update:visible="priceEditorVisible = $event"
    >
      <div class="line-edit-dialog">
        <div class="line-edit-title">
          <strong>{{ priceEditLine?.item_name || '-' }}</strong>
          <span>{{ priceEditLine?.item_code || '' }} / {{ priceEditLine?.unit_code || '' }}</span>
        </div>
        <label class="field">
          <span>ราคา</span>
          <InputNumber v-model="priceEditValue" input-class="text-right" :min="0" :min-fraction-digits="2" :max-fraction-digits="2" autofocus />
        </label>
      </div>
      <template #footer>
        <Button label="ยกเลิก" severity="secondary" outlined @click="priceEditorVisible = false" />
        <Button label="บันทึก" icon="pi pi-check" @click="confirmPriceEditor" />
      </template>
    </Dialog>

    <Dialog
      :visible="remarkEditorVisible"
      header="หมายเหตุรายการ"
      modal
      :draggable="false"
      :style="{ width: 'min(520px, 94vw)' }"
      @update:visible="remarkEditorVisible = $event"
    >
      <div class="line-edit-dialog">
        <div class="line-edit-title">
          <strong>{{ remarkEditLine?.item_name || '-' }}</strong>
          <span>{{ remarkEditLine?.item_code || '' }} / {{ remarkEditLine?.unit_code || '' }}</span>
        </div>
        <label class="field">
          <span>หมายเหตุ</span>
          <Textarea v-model.trim="remarkEditText" rows="4" auto-resize autofocus />
        </label>
      </div>
      <template #footer>
        <Button label="ล้าง" severity="secondary" text @click="remarkEditText = ''" />
        <Button label="ยกเลิก" severity="secondary" outlined @click="remarkEditorVisible = false" />
        <Button label="บันทึก" icon="pi pi-check" @click="confirmRemarkEditor" />
      </template>
    </Dialog>

    <Dialog
      :visible="productDialogVisible"
      header="เลือกสินค้า"
      modal
      :draggable="false"
      :style="{ width: 'min(980px, 96vw)' }"
      @update:visible="productDialogVisible = $event"
    >
      <div class="product-results">
        <div v-if="productResults.length" class="product-result-header">
          <span>รหัส</span>
          <span>สินค้า</span>
          <span>หน่วย</span>
          <span>บาร์โค้ด</span>
          <span>คงเหลือ</span>
        </div>
        <button
          v-for="product in productResults"
          :key="productResultKey(product)"
          class="product-result-row"
          type="button"
          :disabled="documentLocked"
          @click="addProductFromSearch(product)"
        >
          <strong class="result-code">{{ product.item_code }}</strong>
          <span class="result-name">{{ product.item_name }}</span>
          <span class="result-unit">{{ product.unit_code || '-' }}</span>
          <span class="result-barcode">{{ product.barcode || '-' }}</span>
          <span class="result-balance">{{ product.balance_qty == null ? '-' : formatQty(product.balance_qty) }}</span>
        </button>
        <div v-if="!productResults.length" class="empty-lines">ไม่พบสินค้า</div>
      </div>
    </Dialog>

    <SalesProductBasketDialog
      v-model:visible="productBasketVisible"
      :cust-code="custCode"
      :price-opts="priceOpts()"
      @confirm="addProductBasketToSale"
    />

    <Dialog
      :visible="printDialogVisible"
      header="เลือกฟอร์มสำหรับพิมพ์"
      modal
      :draggable="false"
      :style="{ width: 'min(460px, 95vw)' }"
