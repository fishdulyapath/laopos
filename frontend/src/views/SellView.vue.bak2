        </div>
      </div>
      <template #footer>
        <Button label="ปิด" severity="secondary" outlined @click="printDialogVisible = false" />
        <Button label="พิมพ์" icon="pi pi-print" :disabled="!selectedPrintForms.length" @click="confirmPrintForms" />
      </template>
    </Dialog>
  </div>
</template>

