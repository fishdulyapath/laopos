# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /app
ARG VITE_API_BASE_URL=/service/v1
ARG VITE_BASE_PATH=/bizsuit/
ARG VITE_TIGER_MOCK=false
ARG VITE_CHANGE_CURRENCY_CODE=KIP
ARG VITE_CHANGE_ROUNDING_STEP=500
ARG VITE_CHANGE_ROUNDING_MODE=down
ARG VITE_CHANGE_ROUNDING_INCOME_CODE=RD-002
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_TIGER_MOCK=$VITE_TIGER_MOCK
ENV VITE_CHANGE_CURRENCY_CODE=$VITE_CHANGE_CURRENCY_CODE
ENV VITE_CHANGE_ROUNDING_STEP=$VITE_CHANGE_ROUNDING_STEP
ENV VITE_CHANGE_ROUNDING_MODE=$VITE_CHANGE_ROUNDING_MODE
ENV VITE_CHANGE_ROUNDING_INCOME_CODE=$VITE_CHANGE_ROUNDING_INCOME_CODE
ENV NPM_CONFIG_FETCH_RETRIES=5
ENV NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000
ENV NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
ENV NPM_CONFIG_FETCH_TIMEOUT=600000
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache wget
COPY --from=build /app/dist /usr/share/nginx/html/bizsuit
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
