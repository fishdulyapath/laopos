BIZSUIT_STACK_PORT=8091

# Frontend build-time settings for Docker. These intentionally do not reuse
# local Vite .env names, so dev settings such as VITE_BASE_PATH=/ cannot
# accidentally build a broken /bizsuit/ image.
BIZSUIT_VITE_API_BASE_URL=/service/v1
BIZSUIT_VITE_BASE_PATH=/bizsuit/
BIZSUIT_VITE_TIGER_MOCK=false
BIZSUIT_VITE_CHANGE_CURRENCY_CODE=KIP
BIZSUIT_VITE_CHANGE_ROUNDING_STEP=500
BIZSUIT_VITE_CHANGE_ROUNDING_MODE=down
BIZSUIT_VITE_CHANGE_ROUNDING_INCOME_CODE=RD-002

# Backend database settings. Do not commit real credentials.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_IMAGES_NAME=

# Optional smoke login check. Leave blank to skip login in smoke:fullstack.
SMOKE_EMPLOYEE_USER=
SMOKE_EMPLOYEE_PASSWORD=

# Optional write smoke. Set to 1 only on demo/disposable DB; it creates sale documents.
SMOKE_CREATE_SALE=0
