# Copy this file to frontend/.env.production on the Ubuntu server.
# Fill real values on the server only. Do not commit .env.production.

COMPOSE_PROJECT_NAME=laopos-prod
LAOPOS_STACK_PORT=8081

# Docker Hub images.
LAOPOS_SERVICE_IMAGE=minorsoft/laoposservice:latest
LAOPOS_WEB_IMAGE=minorsoft/laoposweb:latest

# Used by deploy scripts. The server deploy uses prebuilt Docker Hub images.
COMPOSE_FILE=deploy/ubuntu/docker-compose.images.yml

# Backend database settings.
# If PostgreSQL runs on the same Ubuntu host as Docker, keep this value.
# If PostgreSQL is on another machine, use that DB host/IP instead.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_IMAGES_NAME=

# Optional smoke login check. Leave blank to skip login.
SMOKE_EMPLOYEE_USER=
SMOKE_EMPLOYEE_PASSWORD=


.env
COMPOSE_PROJECT_NAME=laopos-prod
LAOPOS_STACK_PORT=6326
LAOPOS_SERVICE_IMAGE=minorsoft/laoposservice:latest
LAOPOS_WEB_IMAGE=minorsoft/laoposweb:latest
DB_HOST=sml_postgresql
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sml
DB_NAME=thao_auto
DB_IMAGES_NAME=thao_auto_images
PROVIDER=CUS
SELL_SUMMARY_CURRENCY_CODES=KIP,BTH,VND
