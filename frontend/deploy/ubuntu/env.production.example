# Copy this file to BizSuit/.env.production on the Ubuntu server.
# Fill real values on the server only. Do not commit .env.production.

COMPOSE_PROJECT_NAME=bizsuit-prod
BIZSUIT_STACK_PORT=8081

# Docker Hub images.
BIZSUIT_API_IMAGE=minorsoft/bizsuit-api:latest
BIZSUIT_APP_IMAGE=minorsoft/bizsuit-app:latest

# Used by deploy scripts. The server deploy uses prebuilt Docker Hub images.
COMPOSE_FILE=deploy/ubuntu/docker-compose.images.yml

# Backend database settings.
# If PostgreSQL runs on the same Ubuntu host as Docker, keep this value.
# If PostgreSQL is on another machine, use that DB host/IP instead.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_IMAGES_NAME=

# Optional smoke login check. Leave blank to skip login.
SMOKE_EMPLOYEE_USER=
SMOKE_EMPLOYEE_PASSWORD=
