[Unit]
Description=BizSuit full-stack Docker Compose service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bizs/BizSuit
EnvironmentFile=/opt/bizs/BizSuit/.env.production
ExecStartPre=/usr/bin/docker compose --env-file /opt/bizs/BizSuit/.env.production -f /opt/bizs/BizSuit/deploy/ubuntu/docker-compose.images.yml pull
ExecStart=/usr/bin/docker compose --env-file /opt/bizs/BizSuit/.env.production -f /opt/bizs/BizSuit/deploy/ubuntu/docker-compose.images.yml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/bizs/BizSuit/.env.production -f /opt/bizs/BizSuit/deploy/ubuntu/docker-compose.images.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
